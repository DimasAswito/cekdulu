APP_NAME=CekDulu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
# Jika pakai MySQL saat production, isi kredensial di bawah dan ganti DB_CONNECTION=mysql
